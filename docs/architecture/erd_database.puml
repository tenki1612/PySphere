@startuml erd_database
title PySphere - Entity Relationship Diagram (PostgreSQL)

entity "users" as User {
    * id : INTEGER <<PK, autoincrement>>
    --
    * email : VARCHAR(255) <<unique, indexed>>
    * username : VARCHAR(100) <<unique, indexed>>
    * hashed_password : VARCHAR(255)
    * is_active : BOOLEAN <<default: true>>
    * is_superuser : BOOLEAN <<default: false>>
    * xp : INTEGER <<default: 0>>
    * streak_count : INTEGER <<default: 0>>
    * last_active_date : DATE <<nullable>>
    * created_at : TIMESTAMPTZ <<default: now>>
    * updated_at : TIMESTAMPTZ <<default: now>>
}

entity "lessons" as Lesson {
    * id : INTEGER <<PK, autoincrement>>
    --
    * stage : INTEGER <<indexed>> (1: Basics, 2: Functions, 3: Advanced)
    * day_number : INTEGER <<unique, indexed>> (1 to 60)
    * slug : VARCHAR(100) <<unique, indexed>>
    * title : VARCHAR(255)
    * topic : VARCHAR(100)
    * description_md : TEXT
    * starter_code : TEXT
    * solution_code : TEXT
    * test_cases : JSONB
    * xp_reward : INTEGER <<default: 50>>
    * created_at : TIMESTAMPTZ <<default: now>>
}

entity "user_progress" as UserProgress {
    * id : INTEGER <<PK, autoincrement>>
    --
    * user_id : INTEGER <<FK, indexed>>
    * lesson_id : INTEGER <<FK, indexed>>
    * is_completed : BOOLEAN <<default: false>>
    * draft_code : TEXT <<nullable>>
    * completed_at : TIMESTAMPTZ <<nullable>>
    * updated_at : TIMESTAMPTZ <<default: now>>
}

entity "submissions" as Submission {
    * id : INTEGER <<PK, autoincrement>>
    --
    * user_id : INTEGER <<FK, indexed>>
    * lesson_id : INTEGER <<FK, indexed>>
    * submitted_code : TEXT
    * status : VARCHAR(50) (PASSED, FAILED, RUNTIME_ERROR)
    * execution_time_ms : INTEGER
    * tests_passed : INTEGER <<default: 0>>
    * tests_total : INTEGER <<default: 0>>
    * error_message : TEXT <<nullable>>
    * created_at : TIMESTAMPTZ <<default: now>>
}

User ||--o{ UserProgress : "tracks progress of"
Lesson ||--o{ UserProgress : "has progress from"
User ||--o{ Submission : "submits"
Lesson ||--o{ Submission : "evaluates submissions for"

@enduml
