# PySphere - Interactive Python Learning Platform
# Environment Configuration Template

# Database (PostgreSQL)
POSTGRES_USER=pysphere
POSTGRES_PASSWORD=pysphere_dev_password
POSTGRES_DB=pysphere_db
POSTGRES_PORT=5432

# Backend Database URL
# For Docker: postgresql+asyncpg://pysphere:pysphere_dev_password@db:5432/pysphere_db
# For Local Dev without Postgres: sqlite+aiosqlite:///./pysphere.db
DATABASE_URL=sqlite+aiosqlite:///./pysphere.db

# JWT & Security
SECRET_KEY=change_this_to_a_secure_random_key_with_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend CORS (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

